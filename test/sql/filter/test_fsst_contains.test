# name: test/sql/filter/test_fsst_contains.test
# description: contains on FSST vectors, answered in the compressed domain, returns the rows of the exact predicate
# group: [filter]

require noforcestorage

statement ok
SET storage_compatibility_version='v1.2.0';

statement ok
ATTACH '{TEST_DIR}/fsst_contains.db' AS db;

statement ok
SET force_compression='fsst';

# rows of widely varying length, empty rows, NULL rows, and bytes the symbol table stores as escapes
statement ok
CREATE TABLE db.t AS
SELECT CASE WHEN i % 31 = 0 THEN ''
            WHEN i % 37 = 0 THEN NULL
            WHEN i % 41 = 0 THEN 'esc' || chr((200 + i % 50)::INTEGER) || 'ape_' || (i % 5)::VARCHAR || chr((128 + i % 100)::INTEGER)
            ELSE repeat(md5(i::VARCHAR), 1 + (i % 20)) || '_tail_' || (i % 7)::VARCHAR END AS s
FROM range(50000) tbl(i);

statement ok
CHECKPOINT db;

query I
SELECT count(*) > 0 FROM pragma_storage_info('db.t') WHERE compression = 'FSST';
----
true

# reference: the same predicates on decompressed strings
statement ok
SET enable_fsst_vectors=false;

statement ok
CREATE TABLE db.reference AS
SELECT 'a' AS needle, count(*) AS matches, md5(coalesce(string_agg(s, '|' ORDER BY s), '')) AS digest FROM db.t WHERE contains(s, 'a') UNION ALL
SELECT 'ab', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'ab') UNION ALL
SELECT 'abc', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'abc') UNION ALL
SELECT 'deadbeef', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'deadbeef') UNION ALL
SELECT '_tail_3', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '_tail_3') UNION ALL
SELECT '00000000000000000000', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '00000000000000000000') UNION ALL
SELECT 'empty', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '') UNION ALL
SELECT 'escape', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'ape_2') UNION ALL
SELECT 'escape_byte', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'esc' || chr(210)) UNION ALL
SELECT 'like', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE s LIKE '%beef%' UNION ALL
SELECT 'or', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'abc') OR contains(s, 'def') UNION ALL
SELECT 'or3', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '_tail_1') OR contains(s, '_tail_5') OR contains(s, 'beef') UNION ALL
SELECT 'and', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'abc') AND contains(s, '_tail_6') UNION ALL
SELECT 'not', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE NOT contains(s, 'a');

statement ok
SET enable_fsst_vectors=true;

query I
SELECT count(*) FROM (
    SELECT 'a' AS needle, count(*) AS matches, md5(coalesce(string_agg(s, '|' ORDER BY s), '')) AS digest FROM db.t WHERE contains(s, 'a') UNION ALL
    SELECT 'ab', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'ab') UNION ALL
    SELECT 'abc', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'abc') UNION ALL
    SELECT 'deadbeef', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'deadbeef') UNION ALL
    SELECT '_tail_3', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '_tail_3') UNION ALL
    SELECT '00000000000000000000', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '00000000000000000000') UNION ALL
    SELECT 'empty', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '') UNION ALL
    SELECT 'escape', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'ape_2') UNION ALL
    SELECT 'escape_byte', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'esc' || chr(210)) UNION ALL
    SELECT 'like', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE s LIKE '%beef%' UNION ALL
    SELECT 'or', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'abc') OR contains(s, 'def') UNION ALL
    SELECT 'or3', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, '_tail_1') OR contains(s, '_tail_5') OR contains(s, 'beef') UNION ALL
    SELECT 'and', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE contains(s, 'abc') AND contains(s, '_tail_6') UNION ALL
    SELECT 'not', count(*), md5(coalesce(string_agg(s, '|' ORDER BY s), '')) FROM db.t WHERE NOT contains(s, 'a')
) scanned JOIN db.reference USING (needle)
WHERE scanned.matches <> db.reference.matches OR scanned.digest <> db.reference.digest;
----
0

# the comparison above is only meaningful if every needle joined and most of them matched rows
query II
SELECT count(*), count(*) FILTER (WHERE matches > 0) FROM db.reference;
----
14	12

# a LIKE with only leading and trailing wildcards is rewritten to contains and takes the same path
query I
SELECT count(*) FROM db.t WHERE contains(s, 'beef')
EXCEPT
SELECT count(*) FROM db.t WHERE s LIKE '%beef%';
----
