# name: test/sql/filter/test_fsst_contains_prefilter.test
# description: the FSST code-domain contains prefilter returns the same rows as the exact predicate
# group: [filter]

require noforcestorage

statement ok
SET storage_compatibility_version='v1.2.0';

statement ok
ATTACH '{TEST_DIR}/fsst_contains_prefilter.db' AS db;

statement ok
SET force_compression='fsst';

# rows of widely varying length (up to ~640 bytes, past the 511-byte encoder chunk), plus empty rows.
# NULL rows are left out on purpose: a filter over an FSST column holding NULLs currently fails with
# "Operation requires a flat vector" in the validity scan, independent of this prefilter.
statement ok
CREATE TABLE db.t AS
SELECT CASE WHEN i % 31 = 0 THEN ''
            ELSE repeat(md5(i::VARCHAR), 1 + (i % 20)) || '_tail_' || (i % 7)::VARCHAR END AS s
FROM range(50000) tbl(i);

statement ok
CHECKPOINT db;

query I
SELECT count(*) > 0 FROM pragma_storage_info('db.t') WHERE compression = 'FSST';
----
true

statement ok
SET enable_fsst_vectors=true;

statement ok
SET enable_contains_prefilter=true;

# reference: the exact predicate, with the code-domain scan switched off
statement ok
SET enable_fsst_contains_prefilter=false;

statement ok
CREATE TABLE db.reference AS
SELECT 'a' AS needle, count(*) AS matches FROM db.t WHERE contains(s, 'a') UNION ALL
SELECT 'ab', count(*) FROM db.t WHERE contains(s, 'ab') UNION ALL
SELECT 'abc', count(*) FROM db.t WHERE contains(s, 'abc') UNION ALL
SELECT 'deadbeef', count(*) FROM db.t WHERE contains(s, 'deadbeef') UNION ALL
SELECT '_tail_3', count(*) FROM db.t WHERE contains(s, '_tail_3') UNION ALL
SELECT '00000000000000000000', count(*) FROM db.t WHERE contains(s, '00000000000000000000') UNION ALL
SELECT 'or', count(*) FROM db.t WHERE contains(s, 'abc') OR contains(s, 'def') UNION ALL
SELECT 'or3', count(*) FROM db.t WHERE contains(s, '_tail_1') OR contains(s, '_tail_5') OR contains(s, 'beef');

# the scan is a prefilter, so switching it on may not change a single row
statement ok
SET enable_fsst_contains_prefilter=true;

query I
SELECT count(*) FROM (
    SELECT 'a' AS needle, count(*) AS matches FROM db.t WHERE contains(s, 'a') UNION ALL
    SELECT 'ab', count(*) FROM db.t WHERE contains(s, 'ab') UNION ALL
    SELECT 'abc', count(*) FROM db.t WHERE contains(s, 'abc') UNION ALL
    SELECT 'deadbeef', count(*) FROM db.t WHERE contains(s, 'deadbeef') UNION ALL
    SELECT '_tail_3', count(*) FROM db.t WHERE contains(s, '_tail_3') UNION ALL
    SELECT '00000000000000000000', count(*) FROM db.t WHERE contains(s, '00000000000000000000') UNION ALL
    SELECT 'or', count(*) FROM db.t WHERE contains(s, 'abc') OR contains(s, 'def') UNION ALL
    SELECT 'or3', count(*) FROM db.t WHERE contains(s, '_tail_1') OR contains(s, '_tail_5') OR contains(s, 'beef')
) scanned JOIN db.reference USING (needle)
WHERE scanned.matches <> db.reference.matches;
----
0

# the comparison above is only meaningful if every needle joined and most of them matched rows
query II
SELECT count(*), count(*) FILTER (WHERE matches > 0) FROM db.reference;
----
8	6

# a needle that does occur must still find its rows
query I
SELECT count(*) > 0 FROM db.t WHERE contains(s, '_tail_3');
----
true

# the prefilter must not turn a filtered scan into wrong rows either
query I
SELECT count(*) FROM db.t WHERE s IS NOT NULL AND length(s) > 200 AND contains(s, 'abc')
EXCEPT
SELECT count(*) FROM db.t WHERE s IS NOT NULL AND length(s) > 200 AND s LIKE '%abc%';
----
